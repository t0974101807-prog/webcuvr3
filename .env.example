# ==============================================================================
# LEGAL OS – PRODUCTION ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================

# Core Application Settings
NODE_ENV=production
PORT=3000
APP_URL=https://legalos.vn
CORS_ORIGIN=https://legalos.vn

# Security & Session Authentication
SESSION_SECRET=replace_with_32_byte_secure_random_hex
JWT_SECRET=replace_with_32_byte_secure_random_hex
JWT_EXPIRES_IN=7d

# Primary Relational Database (PostgreSQL)
DATABASE_URL=postgresql://legal_user:replace_with_secure_password@postgres:5432/legal_os_db
DB_POOL_MIN=5
DB_POOL_MAX=25
DB_IDLE_TIMEOUT_MS=30000

# Cache & Message Queue (Redis)
REDIS_URL=redis://:replace_with_redis_password@redis:6379/0
REDIS_PASSWORD=replace_with_redis_password

# AI Agent Service & Resilient Failover Providers
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
DEEPSEEK_API_KEY=
OPENROUTER_API_KEY=

# Memory Monitoring & OOM Self-Protection Subsystem
MEMORY_MONITOR_ENABLED=true
MEMORY_MONITOR_INTERVAL_MS=5000
MEMORY_WARNING_PERCENT=70
MEMORY_CRITICAL_PERCENT=85
MEMORY_OOM_PERCENT=95
MEMORY_STATE_BUFFER_SIZE=500

# High-Concurrency Resource Throttle
PDF_MAX_CONCURRENCY=2
OCR_MAX_CONCURRENCY=2
AI_MAX_CONCURRENCY=3
EMBEDDING_MAX_CONCURRENCY=3
REPORT_MAX_CONCURRENCY=2

# Storage & File Uploads
UPLOAD_DIR=/app/uploads
MAX_FILE_SIZE_MB=50

# Monitoring & Prometheus
METRICS_PORT=9090
PROMETHEUS_ENABLED=true

# Looker Studio Integration Secret Key
LOOKER_SYNC_SECRET=ÁnhDươngLawfirmLookerStudio2026SecureKey!
